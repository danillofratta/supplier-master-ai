SUPPLIER_GATEWAY_URL=http://127.0.0.1:8000
SUPPLIER_API_PREFIX=/api/v1
SUPPLIER_API_TIMEOUT_SECONDS=60

# stdio for local MCP hosts; streamable-http for Docker/deployed execution.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8010
MCP_ALLOWED_HOSTS=localhost,localhost:8010,127.0.0.1,127.0.0.1:8010,mcp-supplier,mcp-supplier:8010
MCP_ALLOWED_ORIGINS=http://localhost:6274,http://127.0.0.1:6274

LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
