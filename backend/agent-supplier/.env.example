# Existing/default provider: Amazon Bedrock
AGENT_AI_PROVIDER=bedrock
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0

# Agent runtime
SUPPLIER_MCP_URL=http://127.0.0.1:8010/mcp
LANGGRAPH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplier_agent_db
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8011
AGENT_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENT_TEMPERATURE=0.1
AGENT_MAX_TOKENS=1500

# Optional provider: OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Optional provider: Gemini
# GOOGLE_API_KEY=
# GEMINI_MODEL=
