# Docker-only settings shared by the SQS workers/consumers.
# Copy this file to .env.docker before running Docker Compose.
AWS_REGION=us-east-2
AWS_PROFILE=default

# Existing AWS SQS queues.
SQS_SAP_REQUEST_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/ACCOUNT_ID/supplier-sap-sync-requests
SQS_SAP_RESULT_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/ACCOUNT_ID/supplier-sap-sync-results

# Optional worker polling interval.
OUTBOX_POLL_INTERVAL_SECONDS=2
